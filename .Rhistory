get_image_dimensions <- function(path) {
img <- image_read(path)
info <- image_info(img)
return(c(width = info$width, height = info$height))
}
# Exemplo com 1 imagem por categoria
dimensoes <- lapply(img_dirs, function(path) {
arquivos <- list.files(path, pattern = "\\.(jpg|png|jpeg)$", full.names = TRUE)
get_image_dimensions(arquivos[1])
})
df_dim <- data.frame(Categoria = categorias,
Largura = sapply(dimensoes, function(x) x['width']),
Altura = sapply(dimensoes, function(x) x['height']))
print(df_dim)
