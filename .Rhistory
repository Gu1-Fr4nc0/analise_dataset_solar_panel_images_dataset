# Caminho das pastas
img_dirs <- list.dirs("archive", recursive = FALSE)
# Categorias
categorias <- basename(img_dirs)
cat(categorias)
library(tidyverse)
# Contar imagens por pasta
img_count <- sapply(img_dirs, function(path) {
length(list.files(path, pattern = "\\.(jpg|png|jpeg)$"))
})
df <- data.frame(Categoria = categorias, Quantidade = img_count)
# Gráfico de barras
ggplot(df, aes(x = Categoria, y = Quantidade, fill = Categoria)) +
geom_bar(stat = "identity") +
theme_minimal() +
labs(title = "Número de Imagens por Categoria")
install.packages("ggplot2")
