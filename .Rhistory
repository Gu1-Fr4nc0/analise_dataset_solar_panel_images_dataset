library(EBImage)
install.packages("EBImage")
plot_histogram_rgb <- function(img_path) {
img <- readImage(img_path)
hist_red <- hist(img[,,1], breaks = 30, plot = FALSE)
hist_green <- hist(img[,,2], breaks = 30, plot = FALSE)
hist_blue <- hist(img[,,3], breaks = 30, plot = FALSE)
df_hist <- data.frame(
Intensidade = c(hist_red$mids, hist_green$mids, hist_blue$mids),
Frequencia = c(hist_red$counts, hist_green$counts, hist_blue$counts),
Canal = rep(c("Red", "Green", "Blue"), each = length(hist_red$mids))
)
ggplot(df_hist, aes(x = Intensidade, y = Frequencia, fill = Canal)) +
geom_bar(stat = "identity", position = "dodge") +
scale_fill_manual(values = c("red", "green", "blue")) +
labs(title = paste("Histograma RGB:", basename(img_path)))
}
# Rodar para 1 imagem por categoria
for (dir in img_dirs) {
arquivos <- list.files(dir, pattern = "\\.(jpg|png|jpeg)$", full.names = TRUE)
print(plot_histogram_rgb(arquivos[1]))
}
